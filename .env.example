# HealthAI Disease Prediction System - Environment Configuration
# Copy this file to .env and adjust variables as needed for production.

# Flask Application & Security Secret Key
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=healthai-dev-secret-key-change-in-production-2026-secure

# Server Port
PORT=5000

# Cookie Security (set to True in production with HTTPS)
SESSION_COOKIE_SECURE=False

# Initial Default Administrator Account
# Automatically seeded on first startup if no admin exists
ADMIN_EMAIL=admin@healthai.local
ADMIN_PASSWORD=Admin@HealthAI2026!
ADMIN_NAME=System Administrator

# Optional SMTP Email Configuration for Forgot/Reset Password
# When unconfigured, reset links and tokens are displayed in local API response/logs for developer ease
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@healthai.local
