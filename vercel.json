{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__path=/$1"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "includeFiles": "model/**,backend/**,dataset/**"
    }
  }
}
